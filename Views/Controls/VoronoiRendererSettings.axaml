<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VoronoiNoiseGenerator.Models"
    xmlns:views="using:VoronoiNoiseGenerator.Views"
    x:Class="VoronoiNoiseGenerator.Views.VoronoiRendererSettings"
    x:DataType="models:VoronoiRendererSettings">
    <Grid RowSpacing="5" ColumnSpacing="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Radius:" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Radius, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <Label Grid.Column="0" Grid.Row="1" Content="Samples:" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding MaxSamples, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <Label Grid.Column="0" Grid.Row="2" Content="Subsamples:" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Subsamples, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <Label Grid.Column="0" Grid.Row="3" Content="Seed:" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Seed, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        <Label Grid.Column="0" Grid.Row="4" Content="Wrap:" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" Grid.Row="4" IsChecked="{Binding Wrap, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" />
    </Grid>
</UserControl>